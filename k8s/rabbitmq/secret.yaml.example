# MODELO — RabbitMQ dentro do cluster é usado SÓ no ambiente local (Docker Desktop).
# Em produção (AKS) os serviços usam o CloudAMQP, cujas credenciais ficam nos
# GitHub Secrets dos repositórios. Copie para secret.yaml (ignorado pelo Git).
apiVersion: v1
kind: Secret
metadata:
  name: rabbitmq-secret
type: Opaque
stringData:
  RABBITMQ_DEFAULT_USER: "<usuario>"
  RABBITMQ_DEFAULT_PASS: "<senha>"
