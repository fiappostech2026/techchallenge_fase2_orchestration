# Copie este arquivo para "infra/.env" (mesma pasta) e preencha antes de rodar
# scripts/provision-azure.sh e scripts/setup-github-oidc.sh.
# O arquivo "infra/.env" nunca deve ser commitado no Git (ele está no .gitignore).
# Valores com espaços ou caracteres especiais ($ & ! etc.) vão entre aspas simples: 'valor'.

# --- Azure ---
AZ_LOCATION=eastus
AZ_RESOURCE_GROUP=rg-fcg
# Precisa ser único no Azure inteiro: só letras minúsculas e números (ex.: fcgacr + algo seu).
ACR_NAME=
AKS_NAME=aks-fcg

# --- GitHub ---
# Conta dona dos 4 repositórios (Users, Catalog, Payments e este).
GITHUB_OWNER=fiappostech2026

# --- Secrets das aplicações (enviados para os GitHub Secrets de cada repositório) ---
# Mesma chave nos repositórios do UsersAPI (emite o token), CatalogAPI e Kong (validam).
JWT_SECRET_KEY=

# Dados de acesso ao CloudAMQP (RabbitMQ gerenciado).
RABBITMQ_HOST=
RABBITMQ_VHOST=
RABBITMQ_PORT=5671
RABBITMQ_USE_SSL=true
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Senha do usuário "sa" do SQL Server de cada API (escolha uma senha forte).
USERS_SQL_PASSWORD=
CATALOG_SQL_PASSWORD=

# Elastic Cloud (busca de jogos do CatalogAPI).
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
