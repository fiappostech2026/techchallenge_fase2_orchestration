# Copie este arquivo para ".env" (mesma pasta) antes de rodar o projeto.
# O arquivo ".env" nunca deve ser commitado no Git (ele já está no .gitignore).

# --- Credenciais do RabbitMQ ---
# Usadas tanto para subir o RabbitMQ quanto para os microsserviços se conectarem nele.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Endereço do RabbitMQ (local ou CloudAMQP) ---
# Padrão: container local do docker-compose (rabbitmq, porta 5672, vhost "/", sem TLS).
# Para apontar para o CloudAMQP (necessário para a Azure Function de Notifications, que exige
# broker com IP público), troque estes valores pelos dados da instância CloudAMQP:
#   RABBITMQ_HOST=algo.rmq.cloudamqp.com
#   RABBITMQ_VIRTUALHOST=seu-vhost
#   RABBITMQ_PORT=5671
#   RABBITMQ_USE_SSL=true
#   RABBITMQ_USER=seu-usuario-cloudamqp
#   RABBITMQ_PASSWORD=sua-senha-cloudamqp
RABBITMQ_HOST=rabbitmq
RABBITMQ_VIRTUALHOST=/
RABBITMQ_PORT=
RABBITMQ_USE_SSL=false

# --- Senha do SQL Server privado do CatalogAPI ---
# Usada tanto para subir o SQL Server quanto para o CatalogAPI se conectar nele.
MSSQL_SA_PASSWORD=Catalog@Strong!Pass1

# --- Senha do SQL Server privado do UsersAPI ---
# Usada tanto para subir o SQL Server quanto para o UsersAPI se conectar nele.
USERS_MSSQL_SA_PASSWORD=Users@Strong!Pass1

# --- Chave de assinatura JWT compartilhada entre UsersAPI (emite) e CatalogAPI (valida) ---
# Defina um valor real aqui antes de rodar em produção — o valor padrão
# (usado se esta variável não for definida) é apenas um placeholder de
# desenvolvimento, e está versionado em texto claro nos appsettings.json
# de ambos os serviços (ver "Limitações conhecidas" no README de cada um).
JWT_SECRET_KEY=

# --- Caminhos locais de cada microsserviço ---
# O Docker Compose precisa saber onde, no seu computador, cada repositório
# de microsserviço foi clonado. Ajuste os caminhos abaixo se você clonou
# os repositórios em pastas com nomes diferentes dos sugeridos.
#
# Convenção recomendada: clone todos os repositórios do projeto dentro da
# MESMA pasta pai (irmãos entre si), exatamente como abaixo:
#
#   minha-pasta-do-projeto/
#   ├── FCG.Orchestration/          (este repositório)
#   ├── FCG.Payments/
#   ├── FCG.Notifications/
#   ├── FCG.Catalog/
#   └── techchallenge_fase2_user/   (repositório do UsersAPI)

PAYMENTS_PATH=../FCG.Payments
CATALOG_PATH=../FCG.Catalog
USERS_PATH=../techchallenge_fase2_user
