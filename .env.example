# Copie este arquivo para ".env" (mesma pasta) antes de rodar o projeto.
# O arquivo ".env" nunca deve ser commitado no Git (ele já está no .gitignore).

# --- Credenciais do RabbitMQ ---
# Usadas tanto para subir o RabbitMQ quanto para os microsserviços se conectarem nele.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Caminhos locais de cada microsserviço ---
# O Docker Compose precisa saber onde, no seu computador, cada repositório
# de microsserviço foi clonado. Ajuste os caminhos abaixo se você clonou
# os repositórios em pastas com nomes diferentes dos sugeridos.
#
# Convenção recomendada: clone todos os repositórios do projeto dentro da
# MESMA pasta pai (irmãos entre si), exatamente como abaixo:
#
#   minha-pasta-do-projeto/
#   ├── FCG.Orchestration/   (este repositório)
#   ├── FCG.Payments/
#   ├── FCG.Notifications/
#   ├── users-api/          (repositório do time responsável por Usuários)
#   └── catalog-api/        (repositório do time responsável por Catálogo)

PAYMENTS_PATH=../FCG.Payments
NOTIFICATIONS_PATH=../FCG.Notifications
